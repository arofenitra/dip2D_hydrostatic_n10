#!/usr/bin/env bash
# Allclean -- remove generated results, keep the case setup (0/, constant/, system/).
# Generated by tools/gen_case.py.
set -e
cd "$(cd "$(dirname "$0")" && pwd)"
for d in [1-9]*; do
    [ -d "$d" ] || continue
    [ "$d" = "0" ] || rm -rf "$d"
done
rm -rf postProcessing processor* VTK constant/polyMesh .mpi_shm
rm -f log.* time.txt meta_run.json
echo "cleaned $(basename "$PWD") (kept 0/)"
