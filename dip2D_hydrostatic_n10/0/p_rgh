FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [pressure];

internalField   uniform 100000;

boundaryField
{
    inletLiquid
    {
        type            fixedFluxPressure;
        value           uniform 100000;
    }

    inletGas
    {
        type            fixedFluxPressure;
        value           uniform 100000;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 100000;
    }

    walls
    {
        type            fixedFluxPressure;
        value           uniform 100000;
    }

    frontAndBack
    {
        type            empty;
    }
}

