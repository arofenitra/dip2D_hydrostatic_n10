#!/usr/bin/env bash
# Allrun -- standard OpenFOAM driver: mesh + initial fields + check + solve.
# Generated by tools/gen_case.py; edit params/params.yaml and regenerate instead of editing.
#   ./Allrun              serial (recommended on meshes below ~100k cells)
#   NPROC=12 ./Allrun     parallel (decompose / run / reconstruct)
#   ./Allrun --continue   restart from the latest written time
set -eo pipefail
cd "$(cd "$(dirname "$0")" && pwd)"
source /opt/openfoam14/etc/bashrc
NPROC="${NPROC:-1}"
CONT=""
[ "${1:-}" = "--continue" ] && CONT="-startFrom latestTime"
mkdir -p .mpi_shm   # /dev/shm is blocked in restricted sandboxes; vader still works
MPIOPTS="--oversubscribe --mca btl vader,self --mca btl_vader_backing_directory $PWD/.mpi_shm"

echo "== OpenFOAM ${WM_PROJECT_VERSION} | case dip2D_hydrostatic_n10 | nproc=${NPROC} =="
if [ ! -d constant/polyMesh ]; then
    blockMesh | tee log.blockMesh
    setFields | tee log.setFields
    checkMesh | tee log.checkMesh
else
    checkMesh | tee log.checkMesh
fi

if [ "$NPROC" -gt 1 ]; then
    decomposePar -force | tee log.decomposePar
    # shellcheck disable=SC2086
    mpirun $MPIOPTS -np "$NPROC" foamRun -parallel $CONT | tee log.foamRun
    reconstructPar | tee log.reconstructPar
else
    foamRun $CONT | tee log.foamRun
fi
echo "== done: $(ls -d [0-9]* 2>/dev/null | sort -g | tail -1) =="
