// ---------------------------------------------------------------------------
// Total mixture mass M(t) = volume integral of rho  (mass-balance check)
// ---------------------------------------------------------------------------
totalMass
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    writeControl    runTime;
    writeInterval   0.05;
    cellZone        all;
    operation       volIntegrate;
    fields          (rho);
    writeFields     false;
}

// ---------------------------------------------------------------------------
// Maximum velocity magnitude (spurious-current / CFL diagnostic)
// ---------------------------------------------------------------------------
maxU
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    writeControl    runTime;
    writeInterval   0.05;
    cellZone        all;
    operation       maxMag;
    fields          (U);
    writeFields     false;
}

// ---------------------------------------------------------------------------
// Inlet / outlet mass flow from the solver's phase mass fluxes
// alphaRhoPhi.<phase> [kg/s]; orientedSum uses outward patch normals,
// so inflow is negative.
// ---------------------------------------------------------------------------
massIn
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    writeControl    runTime;
    writeInterval   0.05;
    patches         (inletLiquid inletGas);
    operation       orientedSum;
    fields          (alphaRhoPhi.oil alphaRhoPhi.air);
    writeFields     false;
}

massOut
{
    type            surfaceFieldValue;
    libs ("libfieldFunctionObjects.so");
    writeControl    runTime;
    writeInterval   0.05;
    patch           outlet;
    operation       orientedSum;
    fields          (alphaRhoPhi.oil alphaRhoPhi.air);
    writeFields     false;
}

// ---------------------------------------------------------------------------
// Outlet pressure (area average over the outlet patch) -> p_out(t)
// ---------------------------------------------------------------------------
pOutlet
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    writeControl    runTime;
    writeInterval   0.05;
    patch           outlet;
    operation       areaAverage;
    fields          (p alpha.oil);
    writeFields     false;
}

