// ---------------------------------------------------------------------------
// Point probes: p(t), U(t), alpha(t), T(t) at three locations.
//   probe 0: upstream gas, one cell below the top wall at x=0.5 m  -> p_up(t)
//   probe 1: mid-height at the dip vertex x=3 m
//   probe 2: downstream gas near the outlet
// ---------------------------------------------------------------------------
probes
{
    type            probes;
    libs            ("libsampling.so");
    writeControl    runTime;
    writeInterval   0.05;
    fields          (p U alpha.oil T);
    fixedLocations  false;
    probeLocations
    (
        (0.5 0.2654043388 0.005) (3 0.0240967336 0.005) (5.7 0.2839008338 0.005)
    );
}

