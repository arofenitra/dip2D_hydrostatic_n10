FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      T.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293;

boundaryField
{
    inletLiquid
    {
        type            calculated;
        value           uniform 293;
    }
    inletGas
    {
        type            calculated;
        value           uniform 293;
    }
    outlet
    {
        type            calculated;
        value           uniform 293;
    }
    walls
    {
        type            calculated;
        value           uniform 293;
    }
    frontAndBack
    {
        type            empty;
    }
}


// ************************************************************************* //
